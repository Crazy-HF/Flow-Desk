# 复制本文件为仓库根目录的 .env，再替换所有占位值；.env 已被 Git 忽略，禁止提交真实密钥。
# 本地 Docker Compose 会读取 .env；Spring Boot 的 local profile 也会从仓库根目录导入它。

# MySQL 容器 root 账号密码：仅供本机数据库管理，不能与应用账号共用。
FLOWDESK_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
# MySQL 首次初始化创建的数据库名；与下面 JDBC URL 中的数据库名保持一致。
FLOWDESK_DB_NAME=flowdesk
# MySQL 首次初始化创建的应用账号名；Spring Boot 使用该账号连接。
FLOWDESK_DB_USERNAME=flowdesk
# MySQL 应用账号密码；同时供 Compose 初始化和 Spring Boot 数据源连接。
FLOWDESK_DB_PASSWORD=replace-with-local-db-password
# MySQL 映射到宿主机的端口；修改后须同步修改 FLOWDESK_DB_URL。
FLOWDESK_MYSQL_PORT=3308

# Spring Boot 连接 Redis 的地址；本机 Compose 使用 localhost。
FLOWDESK_REDIS_HOST=localhost
# Redis 映射到宿主机的端口；须与 Compose 的端口映射一致。
FLOWDESK_REDIS_PORT=6380
# 预留的 Redis 密码项；当前 Compose Redis 未配置密码，应用配置也未引用此项，保持空值。
FLOWDESK_REDIS_PASSWORD=

# Spring Boot 的 MySQL JDBC 地址；数据库名、端口须与上方配置一致，保留时区与字符集参数。
FLOWDESK_DB_URL=jdbc:mysql://localhost:3308/flowdesk?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# JWT 签名密钥：填写独立生成的至少 32 字节随机值的 Base64 编码，不使用示例占位值。
FLOWDESK_JWT_SECRET=replace-with-base64-encoded-32-byte-random-secret
# 允许调用后端的前端来源；本地开发默认 Vite 端口，运行 E2E 时另需加入预览来源。
FLOWDESK_ALLOWED_ORIGINS=http://localhost:5173

# AI 工单辅助总开关：默认关闭；完成依赖和隔离验证后，仅在开发/演示环境改为 true。
FLOWDESK_AI_ENABLED=false
# DeepSeek API Key：只在本机 .env 填写真实值，不写进 application.yml、前端、日志或对话。
DEEPSEEK_API_KEY=

# 附件本地暂存根目录：填写 Web 根目录外、可写、持久化的绝对路径；local 驱动还在其下保存最终文件。
FLOWDESK_ATTACHMENT_ROOT=replace-with-absolute-persistent-directory
# 附件最终存储驱动：local 使用本地目录；s3 使用下方 S3 兼容存储配置。
FLOWDESK_ATTACHMENT_STORAGE=local

# 本地 MinIO 管理账号名：Compose 对完整文件插值，即使只启动 MySQL/Redis 也须提供非空值。
FLOWDESK_MINIO_ROOT_USER=replace-with-minio-root-user
# 本地 MinIO 管理密码：与上方账号配套；不要提交真实值。
FLOWDESK_MINIO_ROOT_PASSWORD=replace-with-minio-root-password
# MinIO API 映射到宿主机的端口；s3 驱动的 endpoint 应指向此端口。
FLOWDESK_MINIO_PORT=9000
# MinIO 管理控制台映射到宿主机的端口，仅供本地管理。
FLOWDESK_MINIO_CONSOLE_PORT=9001

# S3 兼容存储 API 地址：local 驱动下不用；s3 驱动使用本地 MinIO 时指向以下地址。
FLOWDESK_ATTACHMENT_S3_ENDPOINT=http://localhost:9000
# S3 兼容存储的私有桶名；本地 minio-init 使用同一名称创建桶。
FLOWDESK_ATTACHMENT_S3_BUCKET=flowdesk-attachments
# S3 签名区域；本地 MinIO 示例使用 us-east-1，其他服务按供应商要求填写。
FLOWDESK_ATTACHMENT_S3_REGION=us-east-1
# S3 访问账号；本地 MinIO 可填上方管理账号，生产环境应使用专门的最小权限凭据。
FLOWDESK_ATTACHMENT_S3_ACCESS_KEY=replace-with-minio-root-user
# S3 访问密钥；与上方访问账号配套，只留在本机/部署环境。
FLOWDESK_ATTACHMENT_S3_SECRET_KEY=replace-with-minio-root-password

# Refresh Cookie 是否仅通过 HTTPS 发送；本地 HTTP 演示为 false，HTTPS 部署应设 true。
FLOWDESK_COOKIE_SECURE=false
