# Copy to .env for Docker Compose, replace every placeholder, and never commit .env.
FLOWDESK_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
FLOWDESK_DB_NAME=flowdesk
FLOWDESK_DB_USERNAME=flowdesk
FLOWDESK_DB_PASSWORD=replace-with-local-db-password
FLOWDESK_MYSQL_PORT=3308

FLOWDESK_REDIS_HOST=localhost
FLOWDESK_REDIS_PORT=6380
FLOWDESK_REDIS_PASSWORD=

FLOWDESK_DB_URL=jdbc:mysql://localhost:3308/flowdesk?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
FLOWDESK_JWT_SECRET=replace-with-base64-encoded-32-byte-random-secret
FLOWDESK_ALLOWED_ORIGINS=http://localhost:5173
FLOWDESK_ATTACHMENT_ROOT=replace-with-absolute-persistent-directory
# 附件存储驱动：local（本地受控目录，默认）| s3（S3 兼容对象存储）。
# local 只需要上面的 root；s3 还需要下面 MinIO / OSS 的 endpoint、bucket 与凭据。
FLOWDESK_ATTACHMENT_STORAGE=local
# MinIO（docker compose 里的对象存储，仅开发/演示用）
FLOWDESK_MINIO_ROOT_USER=replace-with-minio-root-user
FLOWDESK_MINIO_ROOT_PASSWORD=replace-with-minio-root-password
FLOWDESK_MINIO_PORT=9000
FLOWDESK_MINIO_CONSOLE_PORT=9001
# S3 兼容对象存储连接（storage=s3 时必填 bucket / access key / secret key）
FLOWDESK_ATTACHMENT_S3_ENDPOINT=http://localhost:9000
FLOWDESK_ATTACHMENT_S3_BUCKET=flowdesk-attachments
FLOWDESK_ATTACHMENT_S3_REGION=us-east-1
FLOWDESK_ATTACHMENT_S3_ACCESS_KEY=replace-with-minio-root-user
FLOWDESK_ATTACHMENT_S3_SECRET_KEY=replace-with-minio-root-password
FLOWDESK_COOKIE_SECURE=false
